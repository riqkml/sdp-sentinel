# ServiceDesk Plus Cloud / Zoho OAuth
SDP_TOKEN_URL=https://accounts.zoho.com/oauth/v2/token
SDP_API_BASE_URL=https://sdpondemand.manageengine.com/api/v3
SDP_CI_TYPE=ci_computer
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REFRESH_TOKEN=

# Optional field-key overrides for the CI response
SDP_IP_FIELD_KEY=txt_ip_address
SDP_OS_FIELD_KEY=txt_os
SDP_SITE_FIELD_KEY=txt_location
SDP_CRITICALITY_FIELD_KEY=ref_business_impact

# Collector behavior
SDP_PAGE_SIZE=100
SDP_TIMEOUT_SECONDS=30
SDP_MAX_RETRIES=4
SENTINEL_BATCH_SIZE=500

# ServiceDesk Plus ticket/request ingestion
# Keep false until the ticket table and stream are ready.
SDP_TICKETS_ENABLED=false

# Microsoft Sentinel / Azure Monitor Logs Ingestion API
# These values come from the Data Collection Rule (DCR).
AZURE_DCR_ENDPOINT=
AZURE_DCR_IMMUTABLE_ID=
AZURE_DCR_STREAM_NAME=Custom-SDP_CMDB_Asset
AZURE_TICKET_DCR_IMMUTABLE_ID=
AZURE_TICKET_STREAM_NAME=Custom-SDP_Ticket_CL

# Optional Microsoft Entra service principal authentication.
# If used, all three values below are required. Otherwise DefaultAzureCredential
# is used (for example Azure CLI, VS Code, or managed identity).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
